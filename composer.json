{
    "name": "nswdpc/silverstripe-grid-helpers",
    "description": "Allow an editor to specify how lists of elements and elements should render, based on your theme",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "grid",
        "layout",
        "elemental"
    ],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "James Ellis",
            "role": "Developer"
        }
    ],
    "require": {
        "dnadesign/silverstripe-elemental": "^6",
        "silverstripe/framework": "^6",
        "unclecheese/display-logic": "^4"
    },
    "require-dev": {
        "cambis/silverstripe-rector": "^2",
        "cambis/silverstan": "^2",
        "friendsofphp/php-cs-fixer": "^3",
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2",
        "phpstan/phpstan-phpunit": "^2",
        "rector/rector": "^2",
        "nswdpc/ci-files": "dev-v-4"
    },
    "suggest": {
        "dnadesign/silverstripe-elemental-list": "Support elements within a list"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/vendor-plugin": true,
            "silverstripe/recipe-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "autoload": {
        "psr-4": {
            "NSWDPC\\GridHelper\\": "src/",
            "NSWDPC\\GridHelper\\Tests\\" : "tests/"
        }
    },
    "scripts": {
        "phpstan-analyse": "./vendor/bin/phpstan analyse --ansi --no-progress --no-interaction --configuration vendor/nswdpc/ci-files/phpstan/.phpstan.silverstripe.neon src/",
        "rector-dryrun": "./vendor/bin/rector process --dry-run --ansi --config vendor/nswdpc/ci-files/rector/.rector.silverstripe_6_83.php src/ tests/*.php",
        "rector-process": "./vendor/bin/rector process --no-diffs --ansi --config vendor/nswdpc/ci-files/rector/.rector.silverstripe_6_83.php src/ tests/*.php",
        "phpcsfixer-fix": "./vendor/bin/php-cs-fixer fix --ansi --no-interaction --config vendor/nswdpc/ci-files/php-cs-fixer/.php-cs-fixer.php src/"
    }
}
