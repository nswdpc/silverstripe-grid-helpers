{
    "name": "nswdpc/silverstripe-grid-helpers",
    "description": "Allow an editor to specify how lists of elements and elements should render, based on your theme",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "grid",
        "layout",
        "elemental"
    ],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "James Ellis",
            "role": "Developer"
        }
    ],
    "require": {
        "dnadesign/silverstripe-elemental": "^5",
        "silverstripe/framework": "^5",
        "unclecheese/display-logic": "^3"
    },
    "require-dev": {
        "cambis/silverstripe-rector": "^2",
        "cambis/silverstan": "^2",
        "friendsofphp/php-cs-fixer": "^3",
        "phpunit/phpunit": "^9.5",
        "phpstan/phpstan": "^2",
        "phpstan/phpstan-phpunit": "^2",
        "rector/rector": "^2",
        "nswdpc/ci-files": "dev-v-4"
    },
    "suggest": {
        "dnadesign/silverstripe-elemental-list": "Support elements within a list"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/vendor-plugin": true
        }
    },
    "autoload": {
        "psr-4": {
            "NSWDPC\\GridHelper\\": "src/",
            "NSWDPC\\GridHelper\\Tests\\" : "tests/"
        }
    }
}
